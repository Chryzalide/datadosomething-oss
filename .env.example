# BYO provider keys (AD-2 / BYO-keys). Copy to `.env` (git-ignored) and fill in.
# NEVER commit real keys.
#
# Filling these in is SAFE for `pnpm test`. The suites that call a live provider
# need an explicit opt-in as well (RUN_INTEGRATION_TESTS below), so a placeholder
# — or a real key you forgot about — cannot turn a normal test run into a bill or
# into confusing 401 failures.

# Jina Reader — born-digital PDF path (Story 1.4). https://jina.ai/reader/
JINA_API_KEY=

# Mistral OCR — scanned/image PDF path (Story 1.6). https://mistral.ai/
# Also the Nettoyage LLM (Mistral Small, Story 3.1) — same key, both features.
MISTRAL_API_KEY=

# Verified Nettoyage — the 3-stage cleanup (Story 3.3). Accepts
# true/1/yes/on and false/0/no/off; anything else falls back to the default.
#
# The DEFAULT DIFFERS BY ENVELOPE, on purpose (FR-18):
#   • apps/selfhost → ON by default. You run it, you pay your own LLM calls,
#     so there is nothing to gate. Set false to opt out.
#   • apps/hub (hosted) → OFF by default. The free tier is raw; cleaning is
#     included in a paid tier from Epic 5 onward. Set true to enable it.
#
# Nettoyage needs MISTRAL_API_KEY. Enabled without a key simply does not run —
# it never fails a conversion.
NETTOYAGE_ENABLED=

# Live-provider integration tests — OFF unless you say otherwise.
#
# A handful of tests call the real Jina / Mistral endpoints. They cost money and
# need the network, so a key alone does not run them: set this too.
#
#   RUN_INTEGRATION_TESTS=1 corepack pnpm -r test
#
# Leave it empty for normal development; those tests report as skipped.
RUN_INTEGRATION_TESTS=

# Async M-tier delivery via Mistral OCR Batch (Story 5.8, hosted hub only).
#
# A large SCANNED paid job (201–1000 pages) is submitted to Mistral's Batch API
# and delivered later through a claim link, instead of blocking a request for
# minutes. Everything else converts in-request.
#
# ON by default, and safe to leave on: every failure on the enqueue path falls
# through to the in-request conversion, so the worst case is the behaviour that
# preceded the feature. It needs MISTRAL_API_KEY — the same key the realtime OCR
# path uses. No key, no async.
#
# Full reference, including the OQ-12 checklist for the first live batch:
# docs/hosted-async.md
ASYNC_BATCH_ENABLED=
# The OCR model the batch runs (default: mistral-ocr-latest).
ASYNC_BATCH_MODEL=
# How long a claim link is answered for, in whole hours (default: 24).
ASYNC_BATCH_TTL_HOURS=
